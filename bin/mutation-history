#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        require $candidate;

        break;
    }
}

exit((new Rasuvaeff\MutationHistory\Cli())->run(array_slice($argv, 1), \STDOUT, \STDERR));
